# -----------------------------------------------------------------------------
# Security Logs (90-day retention)
# -----------------------------------------------------------------------------

[sec_auth]
homePath   = $SPLUNK_DB/sec_auth/db
coldPath   = $SPLUNK_DB/sec_auth/colddb
thawedPath = $SPLUNK_DB/sec_auth/thaweddb
maxDataSize = auto_high_volume
frozenTimePeriodInSecs = 7776000

[sec_tor]
homePath   = $SPLUNK_DB/sec_tor/db
coldPath   = $SPLUNK_DB/sec_tor/colddb
thawedPath = $SPLUNK_DB/sec_tor/thaweddb
maxDataSize = auto
frozenTimePeriodInSecs = 7776000
