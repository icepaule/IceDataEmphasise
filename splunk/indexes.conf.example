# =============================================================================
# indexes.conf - Splunk Index Definitions for IceDataEmphasise
# =============================================================================
# Copy this file to $SPLUNK_HOME/etc/system/local/indexes.conf or to an
# appropriate app directory under $SPLUNK_HOME/etc/apps/.
#
# Restart Splunk after applying:  splunk restart
#
# Retention:
#   - Security indexes (sec_*):  90 days
#   - All other indexes:         30 days
# =============================================================================

# -----------------------------------------------------------------------------
# Operating System Logs
# -----------------------------------------------------------------------------

[os_journal]
homePath   = $SPLUNK_DB/os_journal/db
coldPath   = $SPLUNK_DB/os_journal/colddb
thawedPath = $SPLUNK_DB/os_journal/thaweddb
maxDataSize = auto_high_volume
frozenTimePeriodInSecs = 2592000

[os_boot]
homePath   = $SPLUNK_DB/os_boot/db
coldPath   = $SPLUNK_DB/os_boot/colddb
thawedPath = $SPLUNK_DB/os_boot/thaweddb
maxDataSize = auto
frozenTimePeriodInSecs = 2592000

[os_packages]
homePath   = $SPLUNK_DB/os_packages/db
coldPath   = $SPLUNK_DB/os_packages/colddb
thawedPath = $SPLUNK_DB/os_packages/thaweddb
maxDataSize = auto
frozenTimePeriodInSecs = 2592000

# -----------------------------------------------------------------------------
# Web Server Logs
# -----------------------------------------------------------------------------

[web_apache]
homePath   = $SPLUNK_DB/web_apache/db
coldPath   = $SPLUNK_DB/web_apache/colddb
thawedPath = $SPLUNK_DB/web_apache/thaweddb
maxDataSize = auto_high_volume
frozenTimePeriodInSecs = 2592000

