# =============================================================================
# IceDataEmphasise - Environment Variables
# =============================================================================
# Copy this file to .env and replace all YOUR_* placeholders with real values.
# NEVER commit the .env file to version control!
# =============================================================================

# --- Cribl Stream ---
CRIBL_VERSION="4.16.1"
CRIBL_INSTALL_DIR="/opt/cribl"
CRIBL_ADMIN_USER="admin"
CRIBL_ADMIN_PASSWORD="YOUR_CRIBL_ADMIN_PASSWORD"
CRIBL_HOME="/opt/cribl"
CRIBL_EDGE_HOME="/opt/cribl-edge"

# --- Cribl Service User ---
CRIBL_SERVICE_USER="cribl"
CRIBL_SERVICE_GROUP="cribl"

# --- Network ---
CRIBL_STREAM_HOST="10.10.0.100"
CRIBL_STREAM_PORT="9000"
CRIBL_STREAM_API_PORT="9000"
CRIBL_EDGE_MGMT_PORT="4200"

# --- Tailscale / Headscale ---
HEADSCALE_URL="https://headscale.thesoc.de"
HEADSCALE_AUTH_KEY="YOUR_HEADSCALE_PREAUTH_KEY"

# --- Splunk ---
SPLUNK_HOST="10.10.0.66"
SPLUNK_HEC_PORT="8088"
SPLUNK_HEC_TOKEN="YOUR_SPLUNK_HEC_TOKEN"
SPLUNK_HEC_TLS="true"
SPLUNK_S2S_PORT="9997"
SPLUNK_ADMIN_USER="admin"
SPLUNK_ADMIN_PASSWORD="YOUR_SPLUNK_ADMIN_PASSWORD"

# --- MinIO S3 ---
MINIO_ROOT_USER="YOUR_MINIO_ROOT_USER"
MINIO_ROOT_PASSWORD="YOUR_MINIO_ROOT_PASSWORD"
MINIO_ENDPOINT="http://localhost:9100"
MINIO_BUCKET="cribl-operational-logs"

# --- Elasticsearch ---
ELASTICSEARCH_URL="http://localhost:9200"

# --- Ollama AI ---
OLLAMA_HOST="10.10.0.210"
OLLAMA_PORT="11434"
OLLAMA_MODEL="qwen2.5:14b"

# --- Docs Server ---
DOCS_PORT="8080"

# --- Backup ---
BACKUP_DIR="/opt/cribl-backups"
BACKUP_RETENTION_DAYS="30"

# --- Confluence (internal docs only) ---
CONFLUENCE_URL="http://10.10.0.154:8090"
CONFLUENCE_USER="YOUR_CONFLUENCE_USER"
CONFLUENCE_TOKEN="YOUR_CONFLUENCE_API_TOKEN"
CONFLUENCE_SPACE_KEY="YOUR_SPACE_KEY"
