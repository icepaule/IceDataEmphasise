{
  "id": "minio_s3",
  "type": "s3",
  "description": "MinIO S3-compatible storage for operational Docker logs",
  "bucket": "${MINIO_BUCKET}",
  "destPath": "docker-logs/${container_name}/${_time:%Y}/${_time:%m}/${_time:%d}",
  "stagePath": "/tmp/cribl-s3-staging",
  "region": "us-east-1",
  "awsAuthenticationMethod": "manual",
  "awsApiKey": "${MINIO_ROOT_USER}",
  "awsSecretKey": "${MINIO_ROOT_PASSWORD}",
  "endpoint": "${MINIO_ENDPOINT}",
  "signatureVersion": "v4",
  "enableAssumeRole": false,
  "addIdToStagePath": true,
  "removeEmptyDirs": 0,
  "objectACL": "private",
  "partitionExpr": "`${container_name || 'unknown'}/${C.Time.strftime(_time, '%Y/%m/%d')}`",
  "format": "json",
  "baseFileName": "`CriblOut`",
  "fileNameSuffix": "`.json.gz`",
  "maxFileSizeMB": 32,
  "maxFileOpenTimeSec": 300,
  "maxFileIdleTimeSec": 30,
  "maxOpenFiles": 100,
  "compress": "gzip",
  "onBackpressure": "block",
  "systemFields": ["cribl_pipe"],
  "pipeline": "passthrough"
}
