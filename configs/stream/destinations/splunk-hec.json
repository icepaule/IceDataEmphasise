{
  "id": "splunk_hec",
  "type": "splunk_hec",
  "url": "http://${SPLUNK_HOST}:${SPLUNK_HEC_PORT}/services/collector",
  "token": "${SPLUNK_HEC_TOKEN}",
  "nestedFields": "none",
  "concurrency": 5,
  "maxPayloadSizeKB": 4096,
  "compress": true,
  "rejectUnauthorized": false,
  "onBackpressure": "block",
  "description": "Splunk HEC - HTTP Event Collector. Uses http:// (not https) per deployment."
}
