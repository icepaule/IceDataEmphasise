{
  "id": "syslog_enrichment",
  "conf": {
    "asyncFuncTimeout": 1000,
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Syslog Enrichment Pipeline - Sets index/sourcetype/source for journal events and extracts syslog fields"
        }
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            { "name": "index", "value": "'os_journal'" },
            { "name": "sourcetype", "value": "'syslog'" },
            { "name": "source", "value": "'cribl:journal'" },
            { "name": "cribl_host", "value": "C.os.hostname()" },
            { "name": "cribl_environment", "value": "'production'" },
            { "name": "cribl_pipeline", "value": "'syslog_enrichment'" }
          ]
        }
      },
      {
        "id": "regex_extract",
        "filter": "true",
        "conf": {
          "regex": "/^(?<syslog_timestamp>\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2})\\s+(?<syslog_host>\\S+)\\s+(?<syslog_program>[^\\[:\\s]+)(?:\\[(?<syslog_pid>\\d+)\\])?:?\\s+(?<message>.*)/",
          "fieldName": "_raw"
        }
      },
      {
        "id": "auto_timestamp",
        "filter": "syslog_timestamp",
        "conf": {}
      }
    ]
  }
}
