{
  "id": "default",
  "routes": [
    {
      "id": "route_apache_access",
      "name": "Apache Access",
      "filter": "source=='file_monitor:apache_access'",
      "pipeline": "pipeline_apache_clf",
      "output": "splunk_hec",
      "final": true
    },
    {
      "id": "route_apache_error",
      "name": "Apache Error",
      "filter": "source=='file_monitor:apache_error'",
      "pipeline": "pipeline_syslog_enrichment",
      "output": "splunk_hec",
      "final": true
    },
    {
      "id": "route_ssh_auth",
      "name": "SSH Auth",
      "filter": "source=='file_monitor:ssh_auth'",
      "pipeline": "pipeline_security_auth",
      "output": "splunk_s2s",
      "final": true
    },
    {
      "id": "route_docker",
      "name": "Docker/HA",
      "filter": "source=='file_monitor:docker_ha' || source=='file_monitor:mosquitto'",
      "pipeline": "pipeline_docker_json",
      "output": "splunk_hec",
      "final": true
    },
    {
      "id": "route_journal",
      "name": "Systemd Journal",
      "filter": "source=='journald:systemd_journal'",
      "pipeline": "pipeline_syslog_enrichment",
      "output": "splunk_s2s",
      "final": true
    },
    {
      "id": "route_samba",
      "name": "Samba",
      "filter": "source=='file_monitor:samba'",
      "pipeline": "pipeline_generic_passthrough",
      "output": "splunk_s2s",
      "final": true
    },
    {
      "id": "route_default",
      "name": "Default",
      "filter": "true",
      "pipeline": "pipeline_generic_passthrough",
      "output": "splunk_hec",
      "final": true
    }
  ]
}
