{
  "id": "passthrough",
  "conf": {
    "asyncFuncTimeout": 1000,
    "functions": [
      {
        "id": "comment",
        "filter": "true",
        "conf": {
          "comment": "Passthrough Pipeline - Sets index/sourcetype/source for syslog events with minimal processing"
        }
      },
      {
        "id": "eval",
        "filter": "true",
        "conf": {
          "add": [
            { "name": "index", "value": "'os_journal'" },
            { "name": "sourcetype", "value": "'syslog'" },
            { "name": "source", "value": "'cribl:syslog'" },
            { "name": "cribl_host", "value": "C.os.hostname()" },
            { "name": "cribl_pipeline", "value": "'passthrough'" }
          ]
        }
      }
    ]
  }
}
